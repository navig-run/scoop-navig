{
  "version": "3.27.2",
  "description": "Terminal-first agent OS: multi-host SSH, encrypted vault, MCP server, AI operator.",
  "homepage": "https://navig.run",
  "license": "Apache-2.0",
  "notes": [
    "The CLI lives inside this Scoop app directory, so `scoop uninstall navig` removes it completely.",
    "The desktop apps (NAVIG Anchor / NAVIG OS) are separate: they use their own runtime under %USERPROFILE%\\.navig."
  ],
  "depends": "python",
  "url": "https://files.pythonhosted.org/packages/0c/08/6a88eff646ce304999778bc245cbfe28ddbbbf45b04ac1d91a67cf8b324a/navig-3.27.2-py3-none-any.whl",
  "hash": "24413317c01fc747b0a45bc468cae33bf673e9b0e2af35c44aa4b900fc667a96",
  "installer": {
    "script": [
      "python -m venv \"$dir\\venv\"",
      "& \"$dir\\venv\\Scripts\\python.exe\" -m pip install --disable-pip-version-check --no-warn-script-location \"$dir\\navig-$version-py3-none-any.whl\""
    ]
  },
  "bin": [
    [
      "venv\\Scripts\\navig.exe",
      "navig"
    ]
  ],
  "checkver": {
    "jsonpath": "$.info.version",
    "url": "https://pypi.org/pypi/navig/json"
  }
}
